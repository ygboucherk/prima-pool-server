# ─────────────────────────────────────────────────────────────
# prima-pool relay environment
# Copy to .env and edit. Run by the POOL OPERATOR.
# ─────────────────────────────────────────────────────────────

# Listen port (must be reachable over UDP from all providers).
WG_LISTEN_PORT=51822
WG_INTERFACE=prima-relay
# The relay's address within the pool's WG ranges (10.23.x.y).
WG_ADDRESS=10.23.255.254/24

# ⚠️ Set a FIXED private key so the public key stays stable across restarts
# (generate once: `wg genkey`). If empty, a new keypair is generated on every
# start, breaking the pool server's relay config.
WG_PRIVATE_KEY=

# Static members: "pubkey=allowedips[,pubkey=allowedips...]"
# allowedips defaults to "0.0.0.0/0,::/0" (forward any cluster IP).
RELAY_PEERS=

# Optional peers file (mounted, hot-reloaded): "pubkey allowedips" per line.
# Leave empty to use the default host path ./relay-peers.
RELAY_PEERS_FILE_HOST=./relay-peers
