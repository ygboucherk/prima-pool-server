# ─────────────────────────────────────────────────────────────
# prima-pool-server — control plane environment
# Copy to .env and edit. Deployed by the POOL OPERATOR.
# ─────────────────────────────────────────────────────────────

# Bind address / port
PRIMA_POOL_HOST=0.0.0.0
PRIMA_POOL_PORT=8000

# Publicly reachable base URL advertised in cluster config URLs
# (e.g. https://pool.example.com). Providers fetch configs from here.
PRIMA_POOL_PUBLIC_BASE_URL=http://127.0.0.1:8000

# ⚠️ Set a strong random secret in production!
PRIMA_POOL_SESSION_SECRET=dev-session-secret-change-me

# Model registry: name:gguf_sha256:required_memory_mb[:input_price:output_price][,...]
# The GGUF hash is the authoritative identity — workers must advertise the same
# hash to join a cluster, so a mismatch is rejected at registration.
# (For local dev without a real model, use a placeholder hash or "<no-hash>".)
# input_price / output_price are per-token rates in balance-minor units
# (10^-12 token); a model is free when both are 0 (legacy entries default to 0).
# Example:
#   PRIMA_POOL_MODELS=deepseek-v4-flash-0731:3f9c2a5e...:16384:1000000:3000000,glm-5.2:9d1b4f...:12288
PRIMA_POOL_MODELS=demo-model:<no-hash>:4096

# Cadence / liveness
PRIMA_POOL_HEARTBEAT_TIMEOUT_S=30
PRIMA_POOL_HEARTBEAT_INTERVAL_S=10
PRIMA_POOL_ASSIGNABLE_GRACE_S=5
PRIMA_POOL_MAX_WORKERS_PER_ACCOUNT=5

# ── Account permissions (admin/user + can_work/can_use) ───────────────
# When a *_PERMISSIONLESS switch is UNSET (or commented out), the corresponding
# capability is open to every non-banned account (historical behavior). Set an
# explicit value to gate it: then an account only gets the capability if its
# own flag is true (managed by an admin via the GUI or /v1/admin/*).
PRIMA_POOL_WORK_PERMISSIONLESS=true
PRIMA_POOL_USE_PERMISSIONLESS=true
# First admin bootstrap: "username:password" (username must not contain a colon).
# Created as admin on startup ONLY if no admin account exists yet. Idempotent —
# never clobbers an existing account or re-promotes a demoted one.
PRIMA_POOL_FIRST_ACCOUNT=

# WireGuard cluster settings
PRIMA_POOL_WG_MTU=1280

# Relay (fallback for NAT'd members; see docs/guides/setup.md Part 6)
# Set ENABLED=true + PUBKEY + ENDPOINT to point clients at a relay you run.
PRIMA_POOL_RELAY_ENABLED=false
PRIMA_POOL_RELAY_PUBKEY=
PRIMA_POOL_RELAY_ENDPOINT=

# ── State / persistence ─────────────────────────────────────
# SQLite database file (all state: accounts, keys, workers, clusters).
# Empty = in-memory only (lost on restart). In Docker the default is
# /data/store.db on a named volume. Legacy JSON snapshots auto-migrate.
PRIMA_POOL_STORE_PATH=

# ── Server-side WireGuard (option A: server joins clusters to proxy) ──
# Set PRIMA_POOL_SERVER_JOIN_WG=true to let the server join cluster WG networks
# and proxy inference requests to the head's llama-server. Requires NET_ADMIN
# + /dev/net/tun (already in docker-compose.yml) and wireguard-tools in the
# server image (installed by the Dockerfile).
PRIMA_POOL_SERVER_JOIN_WG=false
# Leave empty to auto-generate a keypair on first use.
PRIMA_POOL_SERVER_WG_PRIVATE_KEY=
PRIMA_POOL_SERVER_WG_LISTEN_PORT=51821
# Prefix only — the actual per-cluster interface name is a short hash of the
# cluster id (Linux caps interface names at 15 chars), e.g. prima-88255830.
PRIMA_POOL_SERVER_WG_INTERFACE=prima-pool-srv
# Publicly reachable host IP advertised to workers as the server's WG endpoint.
PRIMA_POOL_SERVER_WG_ENDPOINT_HOST=
PRIMA_POOL_SERVER_WG_IP_OFFSET=254
# Port the head's llama-server listens on (proxied by the server).
PRIMA_POOL_API_PORT=8080
